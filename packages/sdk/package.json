{
  "name": "@coding-agent/sdk",
  "version": "1.0.0",
  "description": "Browser-based AI coding agent — frontend SDK",
  "type": "module",
  "main": "./dist/coding-agent-sdk.es.js",
  "module": "./dist/coding-agent-sdk.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/coding-agent-sdk.es.js",
